import { readFileSync, writeFileSync } from "node:fs";

// ブラウザ内の書き出しでも、本体と全く同じサーバー用セキュリティ処理を配る。
const source = readFileSync(new URL("../lib/safe-fetch.ts", import.meta.url), "utf8");
writeFileSync(new URL("../lib/generator/safe-fetch-source.ts", import.meta.url),
  "// Generated by scripts/sync-fetch-runtime.mts. Do not edit by hand.\n" +
  `export const SAFE_FETCH_SOURCE = ${JSON.stringify(source)};\n`);
