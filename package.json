{
  "name": "tsumu",
  "private": true,
  "version": "0.3.0",
  "homepage": "https://github.com/abshrimp/tsumu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abshrimp/tsumu.git"
  },
  "bugs": {
    "url": "https://github.com/abshrimp/tsumu/issues"
  },
  "description": "Design freely. Build openly. An open-source visual website builder that publishes plain Next.js projects to GitHub.",
  "keywords": [
    "website-builder",
    "visual-editor",
    "no-code",
    "nextjs",
    "react",
    "cloudflare-workers",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "abshrimp",
  "engines": {
    "node": ">=26.12.1",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npm run build:worker && node scripts/cloudflare.mjs preview",
    "deploy": "npm run build:worker && node scripts/cloudflare.mjs deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mts",
    "test:e2e": "playwright test",
    "i18n:check": "node --import tsx scripts/i18n-check.mts",
    "build:worker": "node scripts/cloudflare.mjs build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    },
    "@node-minify/core": {
      "glob": "^13.0.6"
    }
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true
  }
}
