{
  "name": "tsumu",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://github.com/abshrimp/tsumu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abshrimp/tsumu.git"
  },
  "bugs": {
    "url": "https://github.com/abshrimp/tsumu/issues"
  },
  "description": "Design freely. Build openly. An open-source visual website builder that publishes plain Next.js projects to GitHub.",
  "keywords": [
    "website-builder",
    "visual-editor",
    "no-code",
    "nextjs",
    "react",
    "cloudflare-workers",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "abshrimp",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npm run build:worker && node scripts/cloudflare.mjs preview",
    "deploy": "npm run build:worker && node scripts/cloudflare.mjs deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mts",
    "test:e2e": "playwright test",
    "i18n:check": "node --import tsx scripts/i18n-check.mts",
    "build:worker": "node scripts/cloudflare.mjs build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    },
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
