# Environment variables (copy to .env.local).
# Local development and Node.js read .env.local; with Docker, pass this file with --env-file;
# on Cloudflare Workers, set each one with `npx wrangler secret put <NAME>`.
#
# Local development opens without any of these variables. Production requires
# Google sign-in or an explicit ALLOW_ANONYMOUS=true setting.
# On Cloudflare, the site list, comments and sign-in allowlist (D1), each site's editing
# data (the DocumentRoom Durable Object) and uploaded assets (Workers KV) are connected
# through the bindings in wrangler.jsonc, so they need no variables.
#
# Outside Cloudflare (npm start, Docker), set TSUMU_DATA_DIR instead: the editor then
# keeps a SQLite database and the uploaded files in that folder. Requires Node.js 26.12.1+ and npm 12.2.1+.
# TSUMU_DATA_DIR=./data

# --- Google sign-in (Auth.js) ---
# Sign-in turns on when AUTH_SECRET, AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET are all set.
# Without them, `npm run dev` accepts anonymous requests addressed to loopback hosts, and
# non-loopback or production access requires ALLOW_ANONYMOUS=true (below).
# Generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Production only: the editor's URL (e.g. https://tsumu.example.workers.dev)
# AUTH_URL=

# OAuth client from the Google Cloud Console
# Authorized redirect URI: https://<editor-domain>/api/auth/callback/google
# (local development: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google accounts that always sign in as Editors (comma-separated; can't be removed in the UI).
# Additional Editor or View-only accounts can be managed from Settings on the home screen.
ALLOWED_EMAILS=you@gmail.com

# Without Google sign-in, only loopback hosts in `npm run dev` open unless this is true.
# Anyone with the URL can then edit and publish: use it only locally or for a demo.
# ALLOW_ANONYMOUS=true

# Browser-local public editor on Cloudflare Workers:
# Make site lists and editable documents local to each visitor even when D1
# is configured. KV asset storage is also disabled in this mode; local inline
# assets are limited to 2 MiB per file. In production set ALLOW_ANONYMOUS=true and do not
# configure AUTH_* when you want editing without a Tsumu login.
# TSUMU_STORAGE_MODE=local

# --- Publishing ---
# Select ONE provider for this Tsumu installation: github (default), netlify, cloudflare.
# Netlify OAuth Client ID is public configuration; each user's token and site IDs
# are held in that user's browser, not the Tsumu database.
# PUBLISH_PROVIDER=github

# Git repositories: select GitHub or GitLab.com in each site's settings.
# Generated source and editable data are committed to the chosen repository.
# Set the corresponding server token (with write access to that repository).
# GitHub: fine-grained token with Contents: Read and write.
GITHUB_TOKEN=
# GitLab.com: personal/group/project access token with api scope and Developer access.
# No self-managed GitLab hosts are supported by this integration.
GITLAB_TOKEN=

# netlify / cloudflare: publish only generated static HTML/CSS/JS and assets.
# Netlify works with local/browser-only site storage and no Tsumu account.
# Cloudflare Pages publishing requires server-backed site storage.
# Optionally prefix generated projects (lowercase letters, digits and hyphens, <= 20).
# Set a unique prefix per independent Tsumu installation to avoid name collisions.
# PUBLISH_PROJECT_PREFIX=tsumu
# Netlify: create an OAuth app at https://app.netlify.com/user/applications
# and register the redirect URL of THIS editor instance (must match exactly).
# The first click on Publish starts Netlify sign-in. After authorization
# the user returns to the editor's Publish dialog. When the account has one
# team it is selected automatically; otherwise the dialog asks which team.
# Netlify usage is billed to that team.
# An administrator token is NEVER used as a fallback.
# NETLIFY_OAUTH_CLIENT_ID=
# NETLIFY_OAUTH_REDIRECT_URI=https://tsumu.ebii.net/netlify/callback
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
#
# Netlify: creates distinct projects for live/test publishing. Per-browser
# credentials are saved in localStorage, bound projects are saved per local site.
# Clearing browser data loses the editable site and connection metadata.
# Netlify tokens pass through the Tsumu server for API calls but are not saved
# there. Existing hosted projects remain online if browser data is deleted.
# Cloudflare Pages: uses <prefix>-<site-id>.pages.dev; test uses the
# tsumu-preview branch. The API token needs Pages Edit permission.
# Configure custom domains at the hosting provider and enter their URLs in
# Tsumu site settings. Removing a Tsumu site never deletes the hosting project.

# --- Ask AI (optional) ---
# AI_ENABLED=true
# anthropic (default) / gemini / openai / openai-compatible
# AI_PROVIDER=gemini
# API key for the provider (ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY also work)
# GEMINI_API_KEY=
# AI_API_KEY=  # Optional shared key; takes precedence over the provider-specific key
# Model ID. Defaults: claude-opus-5-5 (anthropic), gemini-3.8-flash (gemini)
# AI_MODEL=gemini-3.8-flash
# For openai-compatible: the API's base URL
# AI_BASE_URL=https://openrouter.ai/api/v1
# low / medium (default) / high / xhigh / max
# AI_EFFORT=medium

# --- MCP connection (optional) ---
# Base URL of an independent tsumu-mcp server (without the /mcp path).
# Defaults to https://mcp.tsumu.ebii.net when this variable is not set.
# NEXT_PUBLIC_ variables are bundled into the browser at BUILD time.
# Set this as a build environment variable (not only a runtime secret) and rebuild after changes.
# NEXT_PUBLIC_TSUMU_MCP_URL=https://mcp.tsumu.ebii.net

# --- KV asset garbage collection (Cloudflare Workers, optional) ---
# Dry-run by default; set ASSET_GC_ENABLED=true to delete expired unreferenced KV assets.
# See docs/asset-gc.md for policy and limits.
# ASSET_GC_ENABLED=false
# ASSET_GC_GRACE_DAYS=7
# ASSET_GC_MAX_DELETES=500
