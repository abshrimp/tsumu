# Environment variables (copy to .env.local).
# Local development and Node.js read .env.local; with Docker, pass this file with --env-file;
# on Cloudflare Workers, set each one with `npx wrangler secret put <NAME>`.
#
# Local development opens without any of these variables. Production requires
# Google sign-in or an explicit ALLOW_ANONYMOUS=true setting.
# Sites, editing data and the sign-in allowlist (D1) and uploaded assets (Workers KV)
# are connected through the bindings in wrangler.jsonc, so they need no variables.
#
# Outside Cloudflare (npm start, Docker), set TSUMU_DATA_DIR instead: the editor then
# keeps a SQLite database and the uploaded files in that folder. Requires Node.js 22.16+ (22.x) or 24+.
# TSUMU_DATA_DIR=./data

# --- Google sign-in (Auth.js) ---
# Sign-in turns on when AUTH_SECRET, AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET are all set.
# Without them, the editor opens only in `npm run dev` or with ALLOW_ANONYMOUS=true (below).
# Generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Production only: the editor's URL (e.g. https://tsumu.example.workers.dev)
# AUTH_URL=

# OAuth client from the Google Cloud Console
# Authorized redirect URI: https://<editor-domain>/api/auth/callback/google
# (local development: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google accounts that can always sign in (comma-separated; these can't be removed in the UI).
# More accounts can be added from Settings on the home screen.
ALLOWED_EMAILS=you@gmail.com

# Without Google sign-in, the editor only opens in `npm run dev` unless this is true.
# Anyone with the URL can then edit and publish: use it only locally or for a demo.
# ALLOW_ANONYMOUS=true

# --- Publishing (GitHub) ---
# Fine-grained personal access token with Contents: Read and write on every
# site repository. One token is shared by all sites.
GITHUB_TOKEN=

# Each site's repository, branches and URLs are set on the home screen (the site's … → Settings).

# --- Ask AI (optional) ---
# AI_ENABLED=true
# anthropic (default) / gemini / openai / openai-compatible
# AI_PROVIDER=gemini
# API key for the provider (ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY also work)
# GEMINI_API_KEY=
# AI_API_KEY=  # Optional shared key; takes precedence over the provider-specific key
# Model ID. Defaults: claude-opus-5-5 (anthropic), gemini-3.8-flash (gemini)
# AI_MODEL=gemini-3.8-flash
# For openai-compatible: the API's base URL
# AI_BASE_URL=https://openrouter.ai/api/v1
# low / medium (default) / high / xhigh / max
# AI_EFFORT=medium
