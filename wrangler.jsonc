// Cloudflare Workers config for the editor.
// Put your own D1 / KV IDs in a copy of this file named wrangler.local.jsonc (git-ignored).
// npm run dev / preview / deploy use wrangler.local.jsonc when it exists.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tsumu",
	"main": "custom-worker.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// 画像アセットの保存先（Workers KV。カード登録不要の無料枠で使える）。
	// `npx wrangler kv namespace create ASSETS_KV` で作成し、表示された id を設定する
	"kv_namespaces": [
		{
			"binding": "ASSETS_KV",
			"id": "<YOUR_KV_NAMESPACE_ID>"
		}
	],
	// サイト一覧・コメント・許可アカウントの保存先（Cloudflare D1）。
  // 編集データ本体はDOC_STOREのDurable Object内SQLiteに保存する。
	// `npx wrangler d1 create tsumu` で作成し、表示された database_id を設定する
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tsumu",
			"database_id": "<YOUR_D1_DATABASE_ID>"
		}
	],
	// Hosted review builds are public demos: no production database, asset storage or secrets.
	// These settings apply only to Worker Previews, not production or local preview.
	"previews": {
		"vars": { "ALLOW_ANONYMOUS": "true" },
		"d1_databases": [],
		"kv_namespaces": []
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "COLLAB_ROOM",
				"class_name": "CollaborationRoom"
			},
      {
        "name": "DOC_STORE",
        "class_name": "DocumentRoom"
      }
		]
	},
	// Preserve the existing SQLite namespaces and their data by keeping these class names.
	"exports": {
		"CollaborationRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"DocumentRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
